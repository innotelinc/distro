# secrets / env (keep tracked examples, never the real files)
.env
.env.local
.env.*
!.env.example

# Legacy reference checkouts (OmniRoute / bolt.diy) are gone from the repo;
# any stale local vendor/ directory stays out of git.
vendor/

# dependencies & build output (apps/ carry their own more detailed ignores)
node_modules/

# local data & logs
*.log
npm-debug.log*

# backups
backups/

# OS / editor noise
.DS_Store
.idea/
.vscode/
.pnpm-store/
