# ─────────────────────────────────────────────────────────────────────────────
# Distro web (fork of bolt.diy) — environment template
#
# For Docker compose (recommended, from the repo root): copy the ROOT .env
# instead — compose injects the gateway URL automatically. Ignore this file.
#
# For a bare-metal / standalone run of this app:
#   cp .env.example .env.local      # prod-style (wrangler pages dev / docker)
#   cp .env.example .dev.vars       # local dev only (remix vite:dev)
# Then fill in the values below.
# ─────────────────────────────────────────────────────────────────────────────

# ── OmniRoute gateway (Distro's AI backend) — REQUIRED ──────────────────────
# Base URL of your OmniRoute instance. MUST include the /v1 suffix.
#   same host:         http://127.0.0.1:20129/v1   (API port, not dashboard)
#   compose network:   http://gateway:20129/v1      (injected by root compose)
OPENAI_LIKE_API_BASE_URL=http://127.0.0.1:20129/v1

# API key issued by the OmniRoute dashboard (Settings → API Keys).
# This is the ONLY key Distro holds; upstream provider keys live in OmniRoute.
OPENAI_LIKE_API_KEY=

# Optional: default model id preselected in the Distro UI for the gateway
# provider. Use an id your gateway always exposes (e.g. a configured alias).
# When unset the upstream bolt.diy default (claude-3-5-sonnet-latest) is used.
VITE_DEFAULT_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# Optional direct provider keys (bypass the gateway). Upstream bolt.diy keys —
# only needed if you also want direct provider access in addition to the
# OmniRoute gateway. All are optional.
# ─────────────────────────────────────────────────────────────────────────────

# GROQ https://console.groq.com/keys
GROQ_API_KEY=
# HuggingFace https://huggingface.co/settings/tokens
HuggingFace_API_KEY=
# OpenAI https://help.openai.com/en/articles/4936850-where-do-i-find-my-openai-api-key
OPENAI_API_KEY=
# Anthropic https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenRouter https://openrouter.ai/settings/keys
OPEN_ROUTER_API_KEY=
# Google Generative AI https://console.cloud.google.com/apis/credentials
GOOGLE_GENERATIVE_AI_API_KEY=
# Ollama — use http://127.0.0.1:11434 (not localhost, IPv6 issues)
OLLAMA_API_BASE_URL=
# Together https://www.together.ai
TOGETHER_API_BASE_URL=
TOGETHER_API_KEY=
# DeepSeek https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Hyperbolic https://app.hyperbolic.xyz/settings
HYPERBOLIC_API_KEY=
HYPERBOLIC_API_BASE_URL=
# Mistral https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
# Cohere https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# LM Studio — use http://127.0.0.1:1234 (not localhost, IPv6 issues)
LMSTUDIO_API_BASE_URL=
# xAI https://x.ai/api
XAI_API_KEY=
# Perplexity https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# AWS Bedrock — JSON: {"region":"us-east-1","accessKeyId":"...","secretAccessKey":"...","sessionToken":"..."}
AWS_BEDROCK_CONFIG=

# Extra logging for local debugging
VITE_LOG_LEVEL=debug

# GitHub token (optional): import/clone repos without rate limiting, private
# repos, automatic GitHub auth. Classic scopes: repo, read:org, read:user.
VITE_GITHUB_ACCESS_TOKEN=
VITE_GITHUB_TOKEN_TYPE=classic

# Local-LLM context window (ollama-style providers only)
# DEFAULT_NUM_CTX=32768
