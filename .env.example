# ─────────────────────────────────────────────────────────────────────────────
# Distro — environment template
# Copy to .env and fill in. Production secrets come from Cerulean Vault
# (see the VAULT_* block below); the values here are local/dev placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── OmniRoute gateway (REMOTE — platform service) ────────────────────────────
# The AI gateway is a PLATFORM service in the Innotel platform stack (Server 2;
# Consul service "omniroute"). Distro does not ship a gateway — one OmniRoute
# serves the ecosystem, so there is no bundled gateway and no profile to enable.
#
# Service key the control plane uses to MINT and REVOKE each user's gateway
# key via the gateway's dashboard API. Builder traffic itself is spoken by the
# builder surface (Studio) with each user's own key — not by this stack.
# Upstream provider keys live in the gateway — never in Distro.
# May be a Cerulean Vault reference instead of a value; the control plane
# resolves it at import (apps/control-plane/src/secrets.js):
#   OPENAI_LIKE_API_KEY=vault://cerulean/distro#OPENAI_LIKE_API_KEY
OPENAI_LIKE_API_KEY=

# Base URL of the gateway's OpenAI-compatible API, e.g.
#   http://10.10.2.1:20128/v1        (platform stack, Server 2)
#   https://gateway.example.com/v1   (proxied)
# Discover it with: ./stack.sh discover omniroute  (→ host:20128)
# OmniRoute serves its API and its dashboard from that one port, 20128.
# Empty: the compose default is the shared platform gateway,
# http://10.10.2.1:20128/v1.
OPENAI_LIKE_API_BASE_URL=

# Control-plane gateway overrides (server-to-server: key minting, admin API).
# Leave empty to auto-discover via Consul (CONTROL_CONSUL_URL below); set to
# pin, e.g. GATEWAY_DASHBOARD_URL=http://10.10.2.1:20128.
GATEWAY_API_URL=
GATEWAY_DASHBOARD_URL=

# Consul registry used for gateway discovery (platform stack default shown).
CONTROL_CONSUL_URL=http://10.10.1.1:8500

# ── Shared gateway dashboard credential ──────────────────────────────────────
# The control plane mints and revokes each user's gateway key through the
# gateway's own dashboard API, so it needs the dashboard's admin password.
# On the platform gateway that is the OmniRoute dashboard login — keep it
# strong, the dashboard is not otherwise protected.
# May be a Cerulean Vault reference; the control plane resolves it at import
# (apps/control-plane/src/secrets.js), where it becomes GATEWAY_ADMIN_PASSWORD.
#   INITIAL_PASSWORD=vault://cerulean/distro#INITIAL_PASSWORD
INITIAL_PASSWORD=CHANGEME

# ── Retired: the bolt.diy front door ────────────────────────────────────────
# The builder UI (apps/web, the bolt.diy fork) is retired — one web UI
# (Studio, Olympus) serves the ecosystem, and Distro remains as the tenancy
# service: accounts, per-user gateway keys, quotas/usage (§5.2 of the
# convergence doc). What remains of the web-only surface's variables: the
# service key above, the gateway discovery block above, and the two control
# -plane service vars below. Per-user keys live in the control plane's
# database, never in .env. Upstream attribution lives in
# THIRD_PARTY_NOTICES.md / licenses/.

# Port binding — the control plane binds 0.0.0.0 (LAN-reachable) by default;
# 127.0.0.1 for loopback-only. The gateway is not this stack's to bind — it is
# the shared platform service — and there is no web service to bind anymore.
CONTROL_BIND_HOST=0.0.0.0      # control plane (:20140) + admin console at /admin

# Service-to-service token for the control plane's provisioning/audit routes
# (`POST /api/internal/identity`, `POST /api/internal/audit`) — how Studio
# (Olympus) resolves the signed-in Authentik subject to this plane's account
# and records build/publish/export in `audit_log`. Generated by
# `./scripts/bootstrap.sh`. Until it is set, those routes answer 503 rather
# than open; `quota-check`/`usage-report` keep using the user's gateway key.
CONTROL_INTERNAL_TOKEN=

# Optional: the admin console's read-only build-queue view. Point this at the
# queue directory Studio writes and the runner reads (Olympus's
# `.factory/build-queue`, i.e. Studio's STUDIO_BUILD_QUEUE_DIR). It needs to be
# readable from THIS container, so in practice it is a mount; unset simply means
# the panel says the queue is not visible. Read-only by construction — the view
# never writes, claims or cancels a job.
STUDIO_BUILD_QUEUE_DIR=

# M4 usage sync: how often (ms) the control plane reconciles usage_cache with
# the gateway's own per-key ledger. The ledger lives in the gateway's SQLite
# volume, which this stack does not mount (the gateway is remote), so the
# default is 0 (off): quota accounting uses chat-traffic usage reports + key
# spend caps instead. Set it only if a gateway data dir is mounted read-only
# at GATEWAY_DATA_DIR.
CONTROL_SYNC_INTERVAL_MS=0

# Operational alerts: POST a JSON webhook when a user hits a daily quota or
# the gateway usage sync fails (per-event cooldown CONTROL_ALERT_COOLDOWN_MS,
# default 10 min). Works with ntfy/Slack-style/generic receivers. Empty =
# alerts disabled.
# CONTROL_ALERT_WEBHOOK_URL=https://ntfy.sh/your-topic
# CONTROL_ALERT_COOLDOWN_MS=600000

# ── Multi-tenant control plane (apps/control-plane) ─────────────────────────
# Comma-separated emails that sign up as admins. The very first account is
# always an admin (bootstrap). Leave empty to bootstrap manually via the CLI:
#   docker compose exec control-plane node bin/control.mjs create-admin a@b.c pass
CONTROL_ADMIN_EMAILS=

# CONTROL_BIND_HOST=127.0.0.1 for loopback-only. CONTROL_CORS_ORIGIN=
# https://distro.example.com locks cross-origin calls (the Studio server-side
# client and the admin console) to that exact origin (strict: other origins
# get no allow header; their preflights get 403). Empty = permissive '*' for
# direct-LAN use.

# ── Cerulean / Authentik SSO (optional OIDC sign-in) ───────────────────────
# Signing in with Cerulean's Authentik instead of email/password. Cerulean is
# the stack's TrustOps platform (DNS + TLS + Authentik SSO + Cerulean Vault).
# In Cerulean's Authentik create an application with provider type
# "OAuth2/OIDC Provider" (scopes: email, openid, profile) and set the redirect
# URI to the callback URL below. Leave all four empty to disable SSO (the
# button disappears from /login).
#
# Cerulean hosts the shared Authentik at e.g. auth.cerulean.innotel.us; Atlas,
# Magnate and the rest of the stack sign in through the same provider.
#
#   issuer:       the Authentik provider issuer, e.g.
#                 https://auth.cerulean.innotel.us/application/o/distro/
#   redirect_uri: absolute callback URL, e.g.
#                 https://app.example.com/cp/api/auth/oidc/callback
#                 (same origin as the app under the /cp proxy layout, or
#                 http://<host>:20140/api/auth/oidc/callback for direct LAN)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# May be a Cerulean Vault reference — resolved by the control plane before any
# module reads it:
#   OIDC_CLIENT_SECRET=vault://cerulean/distro#OIDC_CLIENT_SECRET
OIDC_CLIENT_SECRET=
# COMMA-SEPARATED when the console answers on more than one origin. The sign-in
# popup returns to the callback the flow started with, and `distro_oidc_state`
# is a host-only cookie, so a single fixed URL only works on the origin it
# names — signing in anywhere else fails with "invalid or expired state". List
# every origin the console is reachable at; the first entry is the canonical
# answer and the rest are used when the request arrives on that origin. Each
# one must be registered on the Authentik provider too (Cerulean's
# `AUTHENTIK_DISTRO_REDIRECT_URI` takes the same comma-separated list).
#
#   OIDC_REDIRECT_URI=https://admin.distro.innotel.us/api/auth/oidc/callback,\
#                     https://cp.distro.innotel.us/api/auth/oidc/callback,\
#                     http://192.168.1.46:20140/api/auth/oidc/callback
OIDC_REDIRECT_URI=

# ── Sign-in posture ─────────────────────────────────────────────────────────
# Identity is Cerulean Authentik, so password sign-in is OFF by default: the
# admin console offers "Continue with Authentik" only, and both
# /api/auth/signup and /api/auth/login answer 403 so a session cannot be minted
# locally even if the form is reached directly.
#
# BREAKGLASS_LOGIN=1 re-enables the local email/password path. Use it only for
# recovery when Authentik is unreachable: set it, restart the control plane,
# sign in, fix Authentik, then unset it and restart again. Leave it unset in
# normal operation. The first account is still the bootstrap admin, and an
# admin can create further accounts while the flag is on.
BREAKGLASS_LOGIN=

# ── Cerulean Vault (SecretOps — HashiCorp Vault, KV v2) ─────────────────────
# Secrets live in Cerulean's Vault; `.env` carries references, not values:
#   OPENAI_LIKE_API_KEY=vault://cerulean/distro#OPENAI_LIKE_API_KEY
# `vault://<mount>/<path>#<key>` is the convention Cerulean resolves at
# startup, so the stack and the platform agree on one format.
#
# The platform runs Vault as `cerulean-vault`. Point VAULT_ADDR at it and give
# this stack the path-scoped `distro` policy token — the file named by
# VAULT_PRODUCT_TOKENS=distro over there, at
# ./data/vault/token/distro.token. Never the root token, never the
# mount-wide `cerulean` policy.
#
#   export VAULT_ADDR=http://vault:8200
#   export VAULT_TOKEN_FILE=./data/vault/token/distro.token
#   python3 scripts/vault-migrate.py --dry-run          # what would move
#   python3 scripts/vault-migrate.py                    # Infisical → Vault
#   python3 scripts/vault-migrate.py --from-env-file .env   # or seed from .env
#
# WHAT RESOLVES, AND WHERE. Any value in this file that is a `vault://`
# reference is replaced before the process that reads it starts:
#
#   control plane (accounts, quotas, OIDC, billing) — apps/control-plane/src/
#     secrets.js, imported first so the config modules see resolved values.
#     Covers OIDC_CLIENT_SECRET, MAGNATE_ENTITLEMENTS_TOKEN, INITIAL_PASSWORD
#     (as GATEWAY_ADMIN_PASSWORD), OPENAI_LIKE_API_KEY (the service key used
#     to mint per-user keys) and anything else that is a reference.
#
# A reference that cannot be resolved stops that container with a message naming
# the environment key — never a value, and never an empty credential that fails
# later somewhere else.
#
# For a checkout with no platform Vault, compose.vault.yml provides a dev-mode
# one — in-memory and auto-unsealed, fine for local iteration and NOT for
# anything whose secrets must survive a restart.
VAULT_ADDR=
VAULT_TOKEN=
# Preferred over VAULT_TOKEN: a file that both the Vault CLI and this stack read.
VAULT_TOKEN_FILE=./data/vault/token/distro.token
VAULT_PREFIX=cerulean
VAULT_PATH=distro
VAULT_NAMESPACE=
# "1" accepts a self-signed certificate; VAULT_CACERT pins a CA instead.
VAULT_SKIP_VERIFY=
VAULT_CACERT=

# ── Magnate billing (optional; remote platform service) ─────────────────────
# Connect Distro to Magnate for subscription billing. Magnate owns Stripe,
# plans and the revenue ledger; Distro checks entitlements via server-to-server
# API calls. There is NO local Magnate — Distro only consumes the remote one.
#
# Resolution order: explicit MAGNATE_URL → Consul service discovery (service
# "magnate", filled in by bootstrap / `make discover-gateway`) → billing
# disabled (free/self-hosted mode with local quota only).
#
#   MAGNATE_URL               – base URL of your Magnate instance; leave empty
#                               to auto-discover via Consul
#   MAGNATE_CONSUL_SERVICE    – consul service name to look up (default "magnate")
#   MAGNATE_ENTITLEMENTS_TOKEN – shared secret for /api/entitlements auth
#                               (optional on trusted networks). Must equal
#                               Magnate's ENTITLEMENTS_API_TOKEN.
#   MAGNATE_BILLING_SLUG      – plan slug to check (default "distro")
#
# In Magnate: create a plan with slug "distro" (or set MAGNATE_BILLING_SLUG)
# and connect Stripe — the control plane auto-seeds the plan on boot. Distro
# users can then subscribe via Magnate and their entitlement status is checked
# automatically. Set Magnate's ENTITLEMENTS_API_TOKEN if you want to gate the
# entitlements/purchase APIs. Manual re-seed: ./scripts/seed-distro-plan.sh
# May be a Cerulean Vault reference, resolved by the control plane at import.
#   MAGNATE_ENTITLEMENTS_TOKEN=vault://cerulean/distro#MAGNATE_ENTITLEMENTS_TOKEN
MAGNATE_URL=
MAGNATE_ENTITLEMENTS_TOKEN=
MAGNATE_BILLING_SLUG=distro

# ── Atlas integration (optional) ──────────────────────────────────────────────
# Connect Distro to Atlas for git exports. When configured, Distro can push
# projects directly to Atlas/Gitea remotes.
#
#   ATLAS_URL              – base URL of your Atlas instance
#                            (e.g. https://atlas.innotel.us)
#   ATLAS_GIT_REMOTE       – Git SSH host for exports
#                            (e.g. git@atlas.innotel.us)
#
# Atlas lives in the Innotel Platform Stack (CodeOps): Gitea repos, Chef AI
# app builder on self-hosted Convex, and the shared OmniRoute gateway. Atlas
# itself consumes the same Magnate + Cerulean services Distro does, so billing
# and identity are shared across the stack.
#
# Atlas also runs an optional self-contained build of its own that wires in
# Magnate billing (ENTITLEMENTS_API_TOKEN) and Cerulean DNS/TLS provisioning
# (CERULEAN_DNS_API_URL / CERULEAN_ADMIN_PASSWORD). See atlas/.env.example.
ATLAS_URL=https://git.atlas.innotel.us
ATLAS_GIT_REMOTE=git@git.atlas.innotel.us:2222
