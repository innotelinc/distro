# ─────────────────────────────────────────────────────────────────────────────
# Distro — environment template
# Copy to .env and fill in. Generate secrets with:
#   openssl rand -base64 48   (JWT_SECRET)
#   openssl rand -hex 32      (API_KEY_SECRET)
# ─────────────────────────────────────────────────────────────────────────────

# ── OmniRoute gateway secrets (consumed by the `gateway` service) ────────────
# JWT signing key for dashboard session tokens (openssl rand -base64 48)
JWT_SECRET=

# Encryption key for upstream provider API keys stored in the gateway SQLite DB
# (openssl rand -hex 32)
API_KEY_SECRET=

# Initial admin password for the OmniRoute dashboard. Seeds a FRESH gateway
# database only — to change the password of an existing deployment run:
#   docker compose exec gateway node /app/bin/reset-password.mjs --password-stdin
# Default "CHANGEME" is insecure; set a strong value now.
INITIAL_PASSWORD=CHANGEME

# ── Gateway runtime ──────────────────────────────────────────────────────────
# Container memory ceiling for the gateway process (Node heap). Coding-agent
# workloads carry large, overlapping contexts; raise this for real traffic.
# The upstream default pin is 1024 MB — Distro defaults to 4096 MB.
GATEWAY_MAX_OLD_SPACE_MB=4096

# Host interface the gateway ports publish on. 0.0.0.0 = reachable from the
# LAN; 127.0.0.1 = loopback only. If you expose it on the LAN, make sure
# INITIAL_PASSWORD is strong (or run `docker compose exec gateway node
# /app/bin/reset-password.mjs`) — the dashboard is NOT otherwise protected.
GATEWAY_BIND_HOST=0.0.0.0

# Dashboard live-WebSocket origins. Add your LAN origin when opening the
# dashboard from another machine, e.g.
#   LIVE_WS_ALLOWED_ORIGINS=http://192.168.1.20:20128
# LIVE_WS_ALLOWED_ORIGINS=http://localhost:20128,http://127.0.0.1:20128

# Pin the published gateway image (e.g. latest, v3.8.51). See docs/upstream.md.
OMNIROUTE_IMAGE_TAG=latest

# ── Distro web (bolt.diy fork) ───────────────────────────────────────────────
# API key issued by the OmniRoute dashboard (Settings → API Keys) that the
# Distro agent will use for every request. This is the ONLY key the web app
# ever holds — upstream provider keys live in the gateway.
OPENAI_LIKE_API_KEY=

# Inside the compose network the web service always reaches the gateway at
# http://gateway:20129/v1 (the OPENAI_LIKE_API_BASE_URL compose override).
# For a non-Docker install set it to e.g. http://127.0.0.1:20129/v1 in
# apps/web/.env.local instead.

# Optional: default model id the Distro UI selects for the gateway provider.
# Use a catalog id your OmniRoute gateway always exposes (prefix included, e.g.
# gemini/gemini-2.5-flash). When unset, the UI auto-selects the first
# plausibly chat-capable model once the gateway catalog loads.
VITE_DEFAULT_MODEL=

# Build-only: V8 heap cap for the `docker compose build web` step (MB). The
# Remix build is memory hungry; raise on big hosts, lower on small ones
# (e.g. 2048 on a 4 GB box). Only used at image build time.
BUILD_HEAP_MB=4096

# Distro product default: true = the UI offers ONLY the OmniRoute gateway
# provider (end users cannot pick a direct upstream provider). Set to false to
# re-enable bolt.diy's direct providers (Anthropic, OpenAI, Ollama, …).
DISTRO_GATEWAY_ONLY=true

# ── Multi-tenant control plane (apps/control-plane) ─────────────────────────
# Comma-separated emails that sign up as admins. The very first account is
# always an admin (bootstrap). Leave empty to bootstrap manually via the CLI:
#   docker compose exec control-plane node bin/control.mjs create-admin a@b.c pass
CONTROL_ADMIN_EMAILS=

# true = the Distro web app requires a control-plane session (login/signup at
# /login) and adopts each user's own gateway key. The login page offers a
# one-click "host key" skip for single-operator use.
DISTRO_CONTROL_PLANE=true

# Browser-facing control-plane port binds like the gateway (0.0.0.0 = LAN).
# CONTROL_BIND_HOST=127.0.0.1 for loopback-only.
# CONTROL_CORS_ORIGIN=https://distro.example.com restricts cross-origin calls.
CONTROL_BIND_HOST=0.0.0.0
