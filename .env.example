[TEMPLATE]
# ─────────────────────────────────────────────────────────────────────────────
# Distro — environment template
# Copy to .env and fill in. Generate secrets with:
#   openssl rand -base64 48   (JWT_SECRET)
#   openssl rand -hex 32      (API_KEY_SECRET)
# ─────────────────────────────────────────────────────────────────────────────

# ── OmniRoute gateway (REMOTE — platform service) ────────────────────────────
# The AI gateway is a PLATFORM service in the Innotel platform stack (Server 2;
# Consul service "omniroute"). Distro does not ship its own gateway unless you
# enable the local fallback below (--profile local-gateway).
#
# API key issued by the OmniRoute dashboard (Settings → API Keys) that the
# Distro agent uses for every request. Upstream provider keys live in the
# gateway — never in Distro.
OPENAI_LIKE_API_KEY=

# Base URL of the gateway's OpenAI-compatible API, e.g.
#   http://10.10.2.1:20129/v1        (platform stack, Server 2)
#   https://gateway.example.com/v1   (proxied)
# Discover it with: ./stack.sh discover omniroute  (→ host:20128)
# Empty + local-gateway profile: defaults to http://gateway:20129/v1.
OPENAI_LIKE_API_BASE_URL=

# Control-plane gateway overrides (server-to-server: key minting, admin API).
# Leave empty to auto-discover via Consul (CONTROL_CONSUL_URL below); set to
# pin, e.g. GATEWAY_DASHBOARD_URL=http://10.10.2.1:20128.
GATEWAY_API_URL=
GATEWAY_DASHBOARD_URL=

# Consul registry used for gateway discovery (platform stack default shown).
CONTROL_CONSUL_URL=http://10.10.1.1:8500

# ── LOCAL gateway fallback (--profile local-gateway only) ────────────────────
# Only for offline/single-host deployments that run the bundled OmniRoute +
# redis: docker compose --profile local-gateway up -d
#
# JWT_SECRET       — dashboard session signing (openssl rand -base64 48)
# API_KEY_SECRET   — encrypts upstream provider keys at rest (openssl rand -hex 32)
# INITIAL_PASSWORD — first dashboard login; change it afterwards via
#   docker compose --profile local-gateway exec gateway node /app/bin/reset-password.mjs --password-stdin
JWT_SECRET=
API_KEY_SECRET=
INITIAL_PASSWORD=CHANGEME

# Local gateway runtime (--profile local-gateway only): container memory
# ceiling (Node heap). Coding-agent workloads carry large, overlapping
# contexts; the upstream default pin is 1024 MB — Distro defaults to 4096 MB.
GATEWAY_MAX_OLD_SPACE_MB=4096

# Host interface the LOCAL gateway ports publish on. 0.0.0.0 = LAN-reachable;
# 127.0.0.1 = loopback only. Also controls dashboard (:20128), API (:20129)
# and live WS (:20132). If exposed on the LAN, make sure INITIAL_PASSWORD is
# strong — the dashboard is NOT otherwise protected.
GATEWAY_BIND_HOST=0.0.0.0

# LOCAL gateway dashboard live-WebSocket origins. Add your LAN origin when
# opening the dashboard from another machine, e.g.
#   LIVE_WS_ALLOWED_ORIGINS=http://192.168.1.20:20128
# LIVE_WS_ALLOWED_ORIGINS=http://localhost:20128,http://127.0.0.1:20128

# Pin the published gateway image used by the LOCAL fallback profile
# (e.g. latest, v3.8.51). See docs/upstream.md.
OMNIROUTE_IMAGE_TAG=latest

# ── Distro web (bolt.diy fork) ───────────────────────────────────────────────
# Optional: default model id the Distro UI selects for the gateway provider.
# Use a catalog id your OmniRoute gateway always exposes (prefix included, e.g.
# gemini/gemini-2.5-flash). When unset, the UI auto-selects the first
# plausibly chat-capable model once the gateway catalog loads.
VITE_DEFAULT_MODEL=

# Build-only: V8 heap cap for the `docker compose build web` step (MB). The
# Remix build is memory hungry; raise on big hosts, lower on small ones
# (e.g. 2048 on a 4 GB box). Only used at image build time.
BUILD_HEAP_MB=4096

# Port bindings — every service binds 0.0.0.0 (LAN-reachable) by default.
# Set any of these to 127.0.0.1 for loopback-only. GATEWAY_BIND_HOST also
# controls the LOCAL gateway's dashboard (:20128), API (:20129), live WS (:20132).
WEB_BIND_HOST=0.0.0.0          # Distro web app (:5173)
CONTROL_BIND_HOST=0.0.0.0      # control plane (:20140) + admin console at /admin
GATEWAY_BIND_HOST=0.0.0.0      # LOCAL OmniRoute gateway (profile local-gateway)

# Quota enforcement (M3). The web app checks the control plane before each
# chat turn and reports token/request usage after it, using the user's
# gateway key as identity. Host-key ("skip for now") traffic is never gated.
# The control plane must be reachable from the web container on this URL.
DISTRO_ENFORCE_QUOTA=true
CONTROL_PLANE_INTERNAL_URL=http://control-plane:20140

# M4 usage sync: how often (ms) the control plane reconciles usage_cache with
# the gateway's own per-key ledger. Only possible when the gateway runs
# LOCALLY (gateway-data volume mounted, --profile local-gateway) — with a
# remote gateway the volume is not available, so the default is 0 (off) and
# quota accounting falls back to chat-traffic usage reports + key spend caps.
CONTROL_SYNC_INTERVAL_MS=0

# Operational alerts: POST a JSON webhook when a user hits a daily quota or
# the gateway usage sync fails (per-event cooldown CONTROL_ALERT_COOLDOWN_MS,
# default 10 min). Works with ntfy/Slack-style/generic receivers. Empty =
# alerts disabled.
# CONTROL_ALERT_WEBHOOK_URL=https://ntfy.sh/your-topic
# CONTROL_ALERT_COOLDOWN_MS=600000

# Distro product default: true = the UI offers ONLY the OmniRoute gateway
# provider (end users cannot pick a direct upstream provider). Set to false to
# re-enable bolt.diy's direct providers (Anthropic, OpenAI, Ollama, …).
DISTRO_GATEWAY_ONLY=true

# ── Multi-tenant control plane (apps/control-plane) ─────────────────────────
# Comma-separated emails that sign up as admins. The very first account is
# always an admin (bootstrap). Leave empty to bootstrap manually via the CLI:
#   docker compose exec control-plane node bin/control.mjs create-admin a@b.c pass
CONTROL_ADMIN_EMAILS=

# true = the Distro web app requires a control-plane session (login/signup at
# /login) and adopts each user's own gateway key. The login page offers a
# one-click "host key" skip for single-operator use.
DISTRO_CONTROL_PLANE=true

# Reverse-proxy mode (e.g. nginx proxy manager). Default: EMPTY + the app
# auto-resolves — direct LAN/localhost use derives http://<host>:20140, and a
# proxied HTTPS host (non-localhost) derives the SAME origin under /cp, so add
# one nginx "advanced" location forwarding /cp/ -> <host>:20140/ (prefix
# stripped) and login works with no CORS involved. Only set an absolute base
# URL (scheme + host[/path]) when the control plane lives on a SEPARATE
# proxied host, e.g. https://cp.example.com (also set CONTROL_CORS_ORIGIN).
VITE_CONTROL_PLANE_URL=

# Public HTTPS origin of this Distro instance, e.g. https://slots.example.com.
# Used by the header origin-mode indicator's one-click "Open HTTPS host" link
# when the app is reached over plain HTTP (chat-only mode). Empty = derive
# https://<same-hostname> when the hostname isn't a bare IP, else hide the
# link. Build-time: `docker compose up -d --build web` to change.
VITE_PUBLIC_ORIGIN=

# Browser-facing control-plane port binds like the gateway (0.0.0.0 = LAN).
# CONTROL_BIND_HOST=127.0.0.1 for loopback-only.
# CONTROL_CORS_ORIGIN=https://distro.example.com locks cross-origin calls to
# that exact origin (strict: other origins get no allow header; their
# preflights get 403). Empty = permissive '*' for direct-LAN use. Only
# relevant when the control plane is NOT same-origin (separate-host layout).
CONTROL_BIND_HOST=0.0.0.0

# ── Authentik SSO (optional OIDC sign-in) ───────────────────────────────────
# Signing in with Authentik instead of email/password. Create an application
# in Authentik with the provider type "OAuth2/OIDC Provider" (scopes: email,
# openid, profile) and set the redirect URI to the callback URL below. Leave
# all four empty to disable SSO (the button disappears from /login).
#   issuer:       the Authentik provider issuer, e.g.
#                 https://auth.example.com/application/o/distro/
#   redirect_uri: absolute callback URL, e.g. https://app.example.com/cp/api/auth/oidc/callback
#                 (same origin as the app under the /cp proxy layout, or
#                 http://<host>:20140/api/auth/oidc/callback for direct LAN)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# ── Magnate billing (optional) ──────────────────────────────────────────────
# Connect Distro to Magnate for subscription billing. Magnate owns Stripe,
# plans and the revenue ledger; Distro checks entitlements via server-to-server
# API calls. Leave MAGNATE_URL empty to disable billing (Distro runs as a
# free/self-hosted tool with local quota only).
#
#   MAGNATE_URL               – base URL of your Magnate instance
#                               (e.g. https://magnate.example.com)
#   MAGNATE_ENTITLEMENTS_TOKEN – shared secret for /api/entitlements auth
#                               (optional on trusted networks)
#   MAGNATE_BILLING_SLUG      – plan slug to check (default "distro")
#
# In Magnate: create a plan with slug "distro" (or set MAGNATE_BILLING_SLUG)
# and connect Stripe. Then Distro users can subscribe via Magnate and their
# entitlement status is checked automatically.
MAGNATE_URL=http://g1-magnate:3010
MAGNATE_ENTITLEMENTS_TOKEN=
MAGNATE_BILLING_SLUG=distro

# ── Atlas integration (optional) ──────────────────────────────────────────────
# Connect Distro to Atlas for git exports. When configured, Distro can push
# projects directly to Atlas/Gitea remotes.
#
#   ATLAS_URL              – base URL of your Atlas instance
#                            (e.g. https://atlas.innotel.us)
#   ATLAS_GIT_REMOTE       – Git SSH host for exports
#                            (e.g. git@atlas.innotel.us)
ATLAS_URL=
ATLAS_GIT_REMOTE=
