[Unit]
Description=Distro tenancy-loop acceptance check
Documentation=https://github.com/innotelinc/distro
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

# Walks the loop a turn takes on this deployment: a subject resolves to an
# account, the account's own gateway key answers the quota gate, usage is
# reported and reads back. A deployment looks healthy while a piece of that loop
# is quietly dead — a key the gateway forgot, a plane that stopped writing
# accounting — and the builder surface reports the result as a model problem.
# It exits non-zero on the first broken step. See docs/ops.md.
[Service]
Type=oneshot
WorkingDirectory=/opt/distro
ExecStart=/usr/bin/bash ./scripts/acceptance-check.sh
